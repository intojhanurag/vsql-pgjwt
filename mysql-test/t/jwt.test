call mtr.add_suppression("Orphaned expansion directory found but not removed");
call mtr.add_suppression("unsupported algorithm");
call mtr.add_suppression("malformed token");
call mtr.add_suppression("invalid base64url encoding");
call mtr.add_suppression("token segments are not valid JSON");

INSTALL EXTENSION vsql_pgjwt;

--echo # jwt_sign: HS256
SELECT vsql_pgjwt.jwt_sign('{"sub":"user-42","exp":1893456000}', 'shhh', 'HS256');

--echo # jwt_sign: HS384
SELECT vsql_pgjwt.jwt_sign('{"sub":"user-42","exp":1893456000}', 'shhh', 'HS384');

--echo # jwt_sign: HS512
SELECT vsql_pgjwt.jwt_sign('{"sub":"user-42","exp":1893456000}', 'shhh', 'HS512');

--echo # jwt_sign: NULL inputs return NULL
SELECT vsql_pgjwt.jwt_sign(NULL, 'shhh', 'HS256');
SELECT vsql_pgjwt.jwt_sign('{}', NULL, 'HS256');
SELECT vsql_pgjwt.jwt_sign('{}', 'shhh', NULL);

--echo # jwt_sign: unsupported algorithm (error — caller controls input)
--error 3200
SELECT vsql_pgjwt.jwt_sign('{}', 'shhh', 'NONE');

--echo # jwt_decode: HS256 token
SELECT vsql_pgjwt.jwt_decode('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIiwiZXhwIjoxODkzNDU2MDAwfQ.JWbmNYte_3w_mu1ru3O07Jt0BCt3Y0tKr4z4pEOIVXA');

--echo # jwt_decode: HS384 token
SELECT vsql_pgjwt.jwt_decode('eyJhbGciOiJIUzM4NCIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIiwiZXhwIjoxODkzNDU2MDAwfQ.tToKYoE8-99YM7AH3EEGI4yjJ8nZGHPGuDtCL90I3oRw-_Y87o0Xj4TaO3r9TGzj');

--echo # jwt_decode: NULL
SELECT vsql_pgjwt.jwt_decode(NULL);

--echo # jwt_decode: malformed token (returns NULL with warning)
SELECT vsql_pgjwt.jwt_decode('not-a-jwt');

--echo # jwt_verify: valid token with far-future exp
SELECT vsql_pgjwt.jwt_verify('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIiwiZXhwIjo5OTk5OTk5OTk5fQ.3mVWMgf8l4cGF47FqbQtb77353Uns4THWU5lGeoIKms', 'shhh', 'HS256');

--echo # jwt_verify: wrong secret
SELECT vsql_pgjwt.jwt_verify('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIiwiZXhwIjo5OTk5OTk5OTk5fQ.3mVWMgf8l4cGF47FqbQtb77353Uns4THWU5lGeoIKms', 'wrong', 'HS256');

--echo # jwt_verify: expired token
SELECT vsql_pgjwt.jwt_verify('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIiwiZXhwIjoxMDAwMDAwMDAwfQ.VcqKSy_JtD3JILtqRi_mbSQ8h-_0XEAThzUuBykeN3s', 'shhh', 'HS256');

--echo # jwt_verify: not-yet-valid token (nbf in the future)
SELECT vsql_pgjwt.jwt_verify('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIiwibmJmIjo5OTk5OTk5OTk5fQ.uIS5P-aGRfitkqke7JrPi5lgEQgyV7q2SJzaHGgw-kY', 'shhh', 'HS256');

--echo # jwt_verify: token without exp/nbf
SELECT vsql_pgjwt.jwt_verify('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIn0.1XTB_3Wf5J7jaUuDNo_tDoy9kI0SOA9Cwe_7Lt29wPM', 'shhh', 'HS256');

--echo # jwt_verify: NULL inputs
SELECT vsql_pgjwt.jwt_verify(NULL, 'shhh', 'HS256');

--echo # jwt_verify: malformed token (returns NULL with warning)
SELECT vsql_pgjwt.jwt_verify('not-a-jwt', 'shhh', 'HS256');

--echo # jwt_verify: unsupported algorithm (returns NULL with warning)
SELECT vsql_pgjwt.jwt_verify('eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIn0.1XTB_3Wf5J7jaUuDNo_tDoy9kI0SOA9Cwe_7Lt29wPM', 'shhh', 'NONE');

--echo # Nested key: exp inside nested object should NOT be matched
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"data":{"exp":1000000000},"active":true}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":true%' AS nested_exp_ignored;

--echo # Roundtrip: sign then decode
SELECT vsql_pgjwt.jwt_decode(vsql_pgjwt.jwt_sign('{"role":"admin"}', 'key', 'HS256'));

--echo # Roundtrip: sign then verify
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"sub":"test"}', 'key', 'HS256'), 'key', 'HS256');

--echo # RS256: sign and verify with generated keys
--exec openssl genrsa 2048 > $MYSQLTEST_VARDIR/tmp/jwt_rsa_priv.pem 2>/dev/null
--exec openssl rsa -in $MYSQLTEST_VARDIR/tmp/jwt_rsa_priv.pem -pubout > $MYSQLTEST_VARDIR/tmp/jwt_rsa_pub.pem 2>/dev/null

--disable_query_log
--perl
use strict;
my $dir = $ENV{MYSQLTEST_VARDIR};
open(my $out, ">", "$dir/tmp/jwt_rsa_keys.inc") or die;
for my $spec (['rsa_privkey', 'jwt_rsa_priv.pem'], ['rsa_pubkey', 'jwt_rsa_pub.pem']) {
  open(my $f, "<", "$dir/tmp/$spec->[1]") or die;
  my $key = do { local $/; <$f> };
  close $f;
  chomp $key;
  print $out "SET \@$spec->[0] = '$key';\n";
}
close $out;
EOF
--source $MYSQLTEST_VARDIR/tmp/jwt_rsa_keys.inc
SELECT vsql_pgjwt.jwt_sign('{"sub":"rs256-test"}', @rsa_privkey, 'RS256') INTO @rs256_token;
--enable_query_log

--echo # RS256: sign produces a token
SELECT LENGTH(@rs256_token) > 100 AS rs256_sign_ok;

--echo # RS256: verify with correct public key
SELECT vsql_pgjwt.jwt_verify(@rs256_token, @rsa_pubkey, 'RS256') LIKE '%"valid":true%' AS rs256_verify_ok;

--echo # RS256: verify with wrong key
SELECT vsql_pgjwt.jwt_verify(@rs256_token, 'wrong-key', 'RS256') LIKE '%"valid":false%' AS rs256_wrong_key_ok;

--echo # RS256: decode shows payload
SELECT vsql_pgjwt.jwt_decode(@rs256_token) LIKE '%"sub":"rs256-test"%' AS rs256_decode_ok;

--echo # Deterministic: jwt_sign produces same output
SELECT vsql_pgjwt.jwt_sign('{"a":1}', 'k', 'HS256') = vsql_pgjwt.jwt_sign('{"a":1}', 'k', 'HS256') AS is_deterministic;

--echo # Expiry: exp is 1000000000 (2001) in every case below, so each token
--echo # is expired and jwt_verify must say so. The escaped quotes matter:
--echo # an escape-unaware string scan loses track of the payload after an
--echo # odd number of them and stops finding exp at all.
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"u":"x","exp":1000000000}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":false%' AS expiry_enforced;
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"u":"x\\"","exp":1000000000}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":false%' AS expiry_enforced;
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"u":"x\\"y\\"z\\"","exp":1000000000}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":false%' AS expiry_enforced;
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"u":"x\\\\","exp":1000000000}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":false%' AS expiry_enforced;

--echo # Expiry: JSON allows any whitespace between the key and the colon
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign(CONCAT('{"exp"', CHAR(10 USING utf8mb4), ':1000000000}'), 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":false%' AS expiry_enforced;

--echo # Expiry: an exp that is not a NumericDate is refused, not ignored
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"exp":"1000000000"}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":false%' AS unreadable_exp_refused;
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"exp":1000000000000000000000}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":false%' AS unreadable_exp_refused;

--echo # Expiry: exp is optional, so a token without one stays valid
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"sub":"nobody"}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":true%' AS no_exp_still_valid;

--echo # nbf in the future is still refused
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"nbf":4000000000}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":false%' AS nbf_enforced;

--echo # A string value equal to a claim name is not that claim
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"sub":"exp","scope":"nbf"}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":true%' AS value_is_not_claim;
SELECT vsql_pgjwt.jwt_verify(vsql_pgjwt.jwt_sign('{"type":"exp","exp":1000000000}', 'k', 'HS256'), 'k', 'HS256') LIKE '%"valid":false%' AS expiry_enforced;

--echo # jwt_decode refuses a segment that is structurally broken. Note this
--echo # is a structural check, not a full JSON parse: value grammar such as
--echo # '{"a":}' is balanced and still gets through.
SELECT vsql_pgjwt.jwt_decode(vsql_pgjwt.jwt_sign('{garbage', 'k', 'HS256')) IS NULL AS malformed_segment_refused;
SELECT JSON_VALID(CONVERT(vsql_pgjwt.jwt_decode(vsql_pgjwt.jwt_sign('{"u":"x\\"","exp":1000000000}', 'k', 'HS256')) USING utf8mb4)) AS envelope_is_json;

--echo # base64url carries no padding and cannot be 1 mod 4 in length
SELECT vsql_pgjwt.jwt_decode('eyJ=hIjoxfQ.eyJhIjoxfQ.sig') IS NULL AS padding_refused;
SELECT vsql_pgjwt.jwt_decode('A.eyJhIjoxfQ.sig') IS NULL AS bad_length_refused;

--echo # mismatched delimiters are not balanced JSON
SELECT vsql_pgjwt.jwt_decode(vsql_pgjwt.jwt_sign('{"a":[1}]', 'k', 'HS256')) IS NULL AS mismatched_refused;
SELECT vsql_pgjwt.jwt_decode(vsql_pgjwt.jwt_sign('{"a":1]', 'k', 'HS256')) IS NULL AS mismatched_refused;

--echo # segments must use the URL-safe alphabet
SELECT vsql_pgjwt.jwt_decode('eyJhIjoxfQ.eyJhIjox+Q.sig') IS NULL AS non_urlsafe_refused;
SELECT vsql_pgjwt.jwt_decode('eyJhIjoxfQ.eyJhIjox/Q.sig') IS NULL AS non_urlsafe_refused;

--echo # Cleanup temp files
--remove_file $MYSQLTEST_VARDIR/tmp/jwt_rsa_priv.pem
--remove_file $MYSQLTEST_VARDIR/tmp/jwt_rsa_pub.pem
--remove_file $MYSQLTEST_VARDIR/tmp/jwt_rsa_keys.inc

UNINSTALL EXTENSION vsql_pgjwt;
